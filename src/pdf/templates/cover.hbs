<div class="section">
    <h1 style="font-size: 20pt; color: #2c5aa0; text-align: center; margin-bottom: 30px;">
        Beratungsanalyse
    </h1>
    
    <div style="text-align: center; margin-bottom: 40px;">
        <h2 style="font-size: 16pt; margin-bottom: 10px;">{{meta.clientName}}</h2>
        <p style="font-size: 12pt; color: #666;">Kunde: {{meta.clientId}}</p>
        <p style="font-size: 12pt; color: #666;">Berater: {{meta.consultantName}}</p>
        <p style="font-size: 12pt; color: #666;">Datum: {{formatDate meta.createdAt}}</p>
    </div>
    
    <div style="background: #f8f9fa; padding: 20px; border-radius: 8px; margin: 20px 0;">
        <h3 style="color: #2c5aa0; margin-bottom: 15px;">Beratungsübersicht</h3>
        <p><strong>Ausgewählte Themen:</strong> {{#each selectedTopics}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>
        <p><strong>Abgeschlossene Themen:</strong> {{#each closedTopics}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>
        <p><strong>Offene Themen:</strong> {{#each openTopics}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>
        {{#if followUpTiming}}
        <p><strong>Nachfassung:</strong> {{followUpTiming}}</p>
        {{/if}}
    </div>
    
    <div class="confidential">
        Diese Analyse ist vertraulich und nur für den genannten Kunden bestimmt.
    </div>
</div>

<div class="page-break"></div>

