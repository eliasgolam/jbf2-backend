    <div class="key-figure-label">Zinssatz Entnahmephase</div>
    <div class="key-figure-value">{{formatPercentage keyFigures.zinsEntnahme}}</div>
  </div>
{{/if}}

{{#if chartImage}}
  <div class="chart-container">
    <img src="{{chartImage}}" alt="Vorsorgerechner Chart" class="chart-image" />
  </div>
{{/if}}

{{#if notes}}
{{notes}}
{{/if}}

