{{#if keyFigures.pillar3a}}
  <div class="kf">
    <div class="key-figure-label">3. Säule A</div>
    <div class="key-figure-value">{{formatCurrency keyFigures.pillar3a}}</div>
  </div>
{{/if}}

{{#if keyFigures.pillar3b}}
  <div class="kf">
    <div class="key-figure-label">3. Säule B</div>
    <div class="key-figure-value">{{formatCurrency keyFigures.pillar3b}}</div>
  </div>
{{/if}}

{{#if keyFigures.lifeInsurance}}
  <div class="kf">
    <div class="key-figure-label">Lebensversicherung</div>
    <div class="key-figure-value">{{formatCurrency keyFigures.lifeInsurance}}</div>
  </div>
{{/if}}

{{#if keyFigures.total}}
  <div class="kf">
    <div class="key-figure-label">Total Vorsorge</div>
    <div class="key-figure-value">{{formatCurrency keyFigures.total}}</div>
  </div>
{{/if}}

{{#if keyFigures.pillar3aMonthly}}
  <div class="kf">
    <div class="key-figure-label">3. Säule A (Monatlich)</div>
    <div class="key-figure-value">{{formatCurrency keyFigures.pillar3aMonthly}}</div>
  </div>
{{/if}}

{{#if keyFigures.pillar3bMonthly}}
  <div class="kf">
    <div class="key-figure-label">3. Säule B (Monatlich)</div>
    <div class="key-figure-value">{{formatCurrency keyFigures.pillar3bMonthly}}</div>
  </div>
{{/if}}

{{#if keyFigures.lifeInsuranceMonthly}}
  <div class="kf">
    <div class="key-figure-label">Lebensversicherung (Monatlich)</div>
    <div class="key-figure-value">{{formatCurrency keyFigures.lifeInsuranceMonthly}}</div>
  </div>
{{/if}}

{{#if keyFigures.totalMonthly}}
  <div class="kf">
    <div class="key-figure-label">Total Vorsorge (Monatlich)</div>
    <div class="key-figure-value">{{formatCurrency keyFigures.totalMonthly}}</div>
  </div>
{{/if}}

{{#if keyFigures.pensionsluecke}}
  <div class="kf">
    <div class="key-figure-label">Pensionslücke (Monatlich)</div>
    <div class="key-figure-value">{{formatCurrency keyFigures.pensionsluecke}}</div>
  </div>
{{/if}}

{{#if keyFigures.entnahmezeitraum}}
  <div class="kf">
    <div class="key-figure-label">Entnahmezeitraum</div>
    <div class="key-figure-value">{{keyFigures.entnahmezeitraum}} Jahre</div>
  </div>
{{/if}}

{{#if keyFigures.sparrate}}
  <div class="kf">
    <div class="key-figure-label">Benötigte Sparrate (Monatlich)</div>
    <div class="key-figure-value">{{formatCurrency keyFigures.sparrate}}</div>
  </div>
{{/if}}

{{#if keyFigures.benoetigtesKapital}}
  <div class="kf">
    <div class="key-figure-label">Benötigtes Kapital</div>
    <div class="key-figure-value">{{formatCurrency keyFigures.benoetigtesKapital}}</div>
  </div>
{{/if}}

{{#if keyFigures.zinsSparen}}
  <div class="kf">
    <div class="key-figure-label">Zinssatz Sparphase</div>
    <div class="key-figure-value">{{formatPercentage keyFigures.zinsSparen}}</div>
  </div>
{{/if}}

{{#if keyFigures.zinsEntnahme}}
