{{#if present}}
<div class="section">
    <h2 class="section-title">{{title}}</h2>
    
    {{#if keyFigures}}
    <div class="key-figures">
        <div class="key-figure">
            <div class="key-figure-label">Anzahl Kinder</div>
            <div class="key-figure-value">{{keyFigures.count}}</div>
        </div>
        <div class="key-figure">
            <div class="key-figure-label">Monatliche Kosten</div>
            <div class="key-figure-value">{{formatCurrency keyFigures.monthlyCosts}}</div>
        </div>
        <div class="key-figure">
            <div class="key-figure-label">Monatlicher Beitrag</div>
            <div class="key-figure-value">{{formatCurrency keyFigures.monthlyContribution}}</div>
        </div>
        <div class="key-figure">
            <div class="key-figure-label">Jährliche Kosten</div>
            <div class="key-figure-value">{{formatCurrency keyFigures.annualCosts}}</div>
        </div>
    </div>
    {{/if}}
    
    {{#if keyFigures.ageGroups.length}}
    <h3 style="color: #2c5aa0; margin: 20px 0 10px 0;">Altersgruppen</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Altersgruppe</th>
                <th>Anzahl</th>
                <th class="currency">Monatliche Kosten</th>
                <th class="currency">Jährliche Kosten</th>
            </tr>
        </thead>
        <tbody>
            {{#each keyFigures.ageGroups}}
            <tr>
                <td>{{ageGroup}}</td>
                <td>{{count}}</td>
                <td class="currency">{{formatCurrency monthlyCosts}}</td>
                <td class="currency">{{formatCurrency annualCosts}}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
    {{/if}}
    
    <h3 style="color: #2c5aa0; margin: 20px 0 10px 0;">Kostenaufstellung</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Kategorie</th>
                <th class="currency">Monatlich (CHF)</th>
                <th class="currency">Jährlich (CHF)</th>
                <th>Beschreibung</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Betreuung</td>
                <td class="currency">{{formatCurrency keyFigures.careCosts}}</td>
                <td class="currency">{{formatCurrency keyFigures.careCostsAnnual}}</td>
                <td>Kita, Hort, Tagesmutter</td>
            </tr>
            <tr>
                <td>Bildung</td>
                <td class="currency">{{formatCurrency keyFigures.educationCosts}}</td>
                <td class="currency">{{formatCurrency keyFigures.educationCostsAnnual}}</td>
                <td>Schulmaterial, Kurse</td>
            </tr>
            <tr>
                <td>Kleidung & Ausrüstung</td>
                <td class="currency">{{formatCurrency keyFigures.clothingCosts}}</td>
                <td class="currency">{{formatCurrency keyFigures.clothingCostsAnnual}}</td>
                <td>Kleidung, Spielzeug, Möbel</td>
            </tr>
            <tr style="background-color: #f8f9fa; font-weight: bold;">
                <td>Total</td>
                <td class="currency">{{formatCurrency keyFigures.monthlyCosts}}</td>
                <td class="currency">{{formatCurrency keyFigures.annualCosts}}</td>
                <td>-</td>
            </tr>
        </tbody>
    </table>
    {{/if}}
    
    {{#if notes}}
    <div style="margin-top: 15px; padding: 10px; background: #e8f4fd; border-left: 4px solid #2c5aa0;">
        <strong>Hinweise:</strong> {{notes}}
    </div>
    {{/if}}
</div>
{{/if}}

<div class="page-break"></div>

