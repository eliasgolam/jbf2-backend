{{#if keyFigures.count}}
  <div class="kf">
    <div class="key-figure-label">Anzahl Kinder</div>
    <div class="key-figure-value">{{keyFigures.count}}</div>
  </div>
{{/if}}

{{#if keyFigures.monthlyCosts}}
  <div class="kf">
    <div class="key-figure-label">Monatliche Kosten</div>
    <div class="key-figure-value">{{formatCurrency keyFigures.monthlyCosts}}</div>
  </div>
{{/if}}

{{#if keyFigures.monthlyContribution}}
  <div class="kf">
    <div class="key-figure-label">Monatlicher Beitrag</div>
    <div class="key-figure-value">{{formatCurrency keyFigures.monthlyContribution}}</div>
  </div>
{{/if}}

{{#if keyFigures.annualCosts}}
  <div class="kf">
    <div class="key-figure-label">Jährliche Kosten</div>
    <div class="key-figure-value">{{formatCurrency keyFigures.annualCosts}}</div>
  </div>
{{/if}}

{{#if keyFigures.careCosts}}
  <div class="kf">
    <div class="key-figure-label">Betreuungskosten</div>
    <div class="key-figure-value">{{formatCurrency keyFigures.careCosts}}</div>
  </div>
{{/if}}

{{#if keyFigures.educationCosts}}
  <div class="kf">
    <div class="key-figure-label">Bildungskosten</div>
    <div class="key-figure-value">{{formatCurrency keyFigures.educationCosts}}</div>
  </div>
{{/if}}

{{#if keyFigures.clothingCosts}}
  <div class="kf">
    <div class="key-figure-label">Kleidung & Ausrüstung</div>
    <div class="key-figure-value">{{formatCurrency keyFigures.clothingCosts}}</div>
  </div>
{{/if}}

{{#if keyFigures.careCostsAnnual}}
  <div class="kf">
    <div class="key-figure-label">Betreuungskosten (Jährlich)</div>
    <div class="key-figure-value">{{formatCurrency keyFigures.careCostsAnnual}}</div>
  </div>
{{/if}}

{{#if keyFigures.educationCostsAnnual}}
  <div class="kf">
    <div class="key-figure-label">Bildungskosten (Jährlich)</div>
    <div class="key-figure-value">{{formatCurrency keyFigures.educationCostsAnnual}}</div>
  </div>
{{/if}}

{{#if keyFigures.clothingCostsAnnual}}
  <div class="kf">
    <div class="key-figure-label">Kleidung & Ausrüstung (Jährlich)</div>
    <div class="key-figure-value">{{formatCurrency keyFigures.clothingCostsAnnual}}</div>
