<!DOCTYPE html>
<html lang="de-CH">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JB Finanz - Beratungsanalyse</title>
    <style>
        @page {
            size: A4;
            margin: 12mm;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 11pt;
            line-height: 1.4;
            color: #333;
            margin: 0;
            padding: 0;
        }
        
        .header {
            border-bottom: 2px solid #2c5aa0;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }
        
        .logo {
            font-size: 18pt;
            font-weight: bold;
            color: #2c5aa0;
        }
        
        .footer {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            text-align: center;
            font-size: 9pt;
            color: #666;
            border-top: 1px solid #ddd;
            padding: 5px 0;
        }
        
        .page-break {
            page-break-before: always;
        }
        
        .section {
            margin-bottom: 20px;
        }
        
        .section-title {
            font-size: 14pt;
            font-weight: bold;
            color: #2c5aa0;
            margin-bottom: 10px;
            border-bottom: 1px solid #ddd;
            padding-bottom: 5px;
        }
        
        .key-figures {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            margin: 10px 0;
        }
        
        .key-figure {
            background: #f8f9fa;
            padding: 10px;
            border-radius: 4px;
            border-left: 4px solid #2c5aa0;
            min-width: 120px;
        }
        
        .key-figure-label {
            font-size: 9pt;
            color: #666;
            margin-bottom: 2px;
        }
        
        .key-figure-value {
            font-size: 12pt;
            font-weight: bold;
            color: #2c5aa0;
        }
        
        .table {
            width: 100%;
            border-collapse: collapse;
            margin: 10px 0;
        }
        
        .table th, .table td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }
        
        .table th {
            background-color: #f8f9fa;
            font-weight: bold;
        }
        
        .currency {
            text-align: right;
        }
        
        .percentage {
            text-align: right;
        }
        
        .date {
            text-align: right;
        }
        
        .confidential {
            font-size: 8pt;
            color: #999;
            text-align: center;
            margin-top: 10px;
        }
        
        .debug {
            background-color: #fff3cd;
            border: 1px solid #ffeaa7;
            color: #856404;
            padding: 8px;
            margin: 10px 0;
            border-radius: 4px;
            font-size: 10pt;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="logo">JB Finanz AG</div>
        <div style="font-size: 10pt; color: #666;">Beratungsanalyse - {{meta.clientName}}</div>
        <div style="font-size: 9pt; color: #666;">Erstellt am: {{formatDate meta.createdAt}}</div>
    </div>

    {{> cover}}
    
    {{#if executiveSummary}}
        {{> executiveSummary}}
    {{/if}}
    
{{#if sections.budget}}
  {{> budget sections.budget}}
  <div class="page-break"></div>
{{/if}}

{{#if sections.savingsPlanner}}
  {{> savings sections.savingsPlanner}}
  <div class="page-break"></div>
{{/if}}

{{#if sections.interestCompare}}
  <div class="section">
    <h2 class="section-title">Zinsvergleich</h2>
    <div class="key-figures">
      <div class="key-figure"><div class="key-figure-label">Anfangskapital</div><div class="key-figure-value">{{formatCurrency sections.interestCompare.keyFigures.initial}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Sparrate</div><div class="key-figure-value">{{formatCurrency sections.interestCompare.keyFigures.monthly}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Laufzeit</div><div class="key-figure-value">{{sections.interestCompare.keyFigures.years}} Jahre</div></div>
      <div class="key-figure"><div class="key-figure-label">Intervall</div><div class="key-figure-value">{{sections.interestCompare.keyFigures.interval}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Einzahlungsart</div><div class="key-figure-value">{{sections.interestCompare.keyFigures.mode}}</div></div>
    </div>
    {{#if sections.interestCompare.chartImage}}
      <img src="{{sections.interestCompare.chartImage}}" style="width:100%; height:auto; margin-top:10px;" />
    {{/if}}
    <table class="table">
      <thead><tr><th>Jahr</th>{{#each sections.interestCompare.rates}}<th>Zins {{this}}%</th>{{/each}}</tr></thead>
      <tbody>
        {{#each sections.interestCompare.chartData}}
          <tr>
            <td>{{this.jahr}}</td>
            {{#each ../sections.interestCompare.rates}}
              <td class="currency">{{formatCurrency (lookup ../this (concat 'zins' this))}}</td>
            {{/each}}
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  <div class="page-break"></div>
{{/if}}

{{#if sections.startOrWait}}
  <div class="section">
    <h2 class="section-title">Starten oder warten</h2>
    <div class="key-figures">
      <div class="key-figure"><div class="key-figure-label">Anfangskapital</div><div class="key-figure-value">{{formatCurrency sections.startOrWait.keyFigures.initial}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Sparrate</div><div class="key-figure-value">{{formatCurrency sections.startOrWait.keyFigures.monthly}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Zinssatz</div><div class="key-figure-value">{{formatPercent sections.startOrWait.keyFigures.rate}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Laufzeit</div><div class="key-figure-value">{{sections.startOrWait.keyFigures.years}} Jahre</div></div>
      <div class="key-figure"><div class="key-figure-label">Wartezeit</div><div class="key-figure-value">{{sections.startOrWait.keyFigures.waitYears}} Jahre</div></div>
      <div class="key-figure"><div class="key-figure-label">Intervall</div><div class="key-figure-value">{{sections.startOrWait.keyFigures.interval}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Einzahlungsart</div><div class="key-figure-value">{{sections.startOrWait.keyFigures.mode}}</div></div>
    </div>
    {{#if sections.startOrWait.chartData}}
      <table class="table">
        <thead>
          <tr><th>Jahr</th><th>Kapital sofort</th><th>Kapital warten</th></tr>
        </thead>
        <tbody>
          {{#each sections.startOrWait.chartData}}
            <tr>
              <td>{{this.jahr}}</td>
              <td class="currency">{{formatCurrency this.sofort}}</td>
              <td class="currency">{{formatCurrency this.warten}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    {{/if}}
  </div>
  <div class="page-break"></div>
{{/if}}

{{#if sections.retirementPension}}
  <div class="section">
    <h2 class="section-title">Altersrenten-Rechner</h2>
    <div class="key-figures">
      <div class="key-figure"><div class="key-figure-label">Name</div><div class="key-figure-value">{{sections.retirementPension.keyFigures.vorname}} {{sections.retirementPension.keyFigures.name}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Geburtsdatum</div><div class="key-figure-value">{{formatDate sections.retirementPension.keyFigures.geburtsdatum}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Zivilstand</div><div class="key-figure-value">{{sections.retirementPension.keyFigures.zivilstand}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Kinder</div><div class="key-figure-value">{{sections.retirementPension.keyFigures.kinder}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Bruttolohn</div><div class="key-figure-value">{{formatCurrency sections.retirementPension.keyFigures.bruttoLohn}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Guthaben bei Rentenbeginn</div><div class="key-figure-value">{{formatCurrency sections.retirementPension.keyFigures.guthabenBeiRentenbeginn}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Benötigtes Einkommen (monatl.)</div><div class="key-figure-value">{{formatCurrency sections.retirementPension.keyFigures.benoetigtesEinkommen}}</div></div>
      <div class="key-figure"><div class="key-figure-label">AHV-Rente (Jahr)</div><div class="key-figure-value">{{formatCurrency sections.retirementPension.keyFigures.ahvRente}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Gesamtrente</div><div class="key-figure-value">{{formatCurrency sections.retirementPension.keyFigures.gesamtRente}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Monatliche Rente</div><div class="key-figure-value">{{formatCurrency sections.retirementPension.keyFigures.monatlicheRente}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Monatliche Lücke</div><div class="key-figure-value">{{formatCurrency sections.retirementPension.keyFigures.monatlicheLuecke}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Gesamtlücke</div><div class="key-figure-value">{{formatCurrency sections.retirementPension.keyFigures.gesamtluecke}}</div></div>
    </div>
    {{#if sections.retirementPension.chartImage}}
      <img src="{{sections.retirementPension.chartImage}}" style="width:100%; height:auto; margin-top:10px;" />
    {{/if}}
    {{#if sections.retirementPension.chartData}}
      <table class="table">
        <thead>
          <tr><th></th><th>Monatliche Rente</th><th>Monatliche Lücke</th></tr>
        </thead>
        <tbody>
          {{#each sections.retirementPension.chartData}}
            <tr>
              <td>{{this.label}}</td>
              <td class="currency">{{formatCurrency this.rente}}</td>
              <td class="currency">{{formatCurrency this.luecke}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    {{/if}}
  </div>
  <div class="page-break"></div>
{{/if}}

{{#if sections.vorsorgerechner.present}}
  <div class="section">
    <h2 class="section-title">Vorsorgerechner</h2>
    <div class="key-figures">
      <div class="key-figure"><div class="key-figure-label">Pensionslücke (Monatlich)</div><div class="key-figure-value">{{formatCurrency sections.vorsorgerechner.keyFigures.pensionsluecke}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Entnahmezeitraum</div><div class="key-figure-value">{{sections.vorsorgerechner.keyFigures.entnahmezeitraum}} Jahre</div></div>
      <div class="key-figure"><div class="key-figure-label">Pensionsantritt</div><div class="key-figure-value">{{formatDate sections.vorsorgerechner.keyFigures.pensionsantritt}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Entnahme starten am</div><div class="key-figure-value">{{formatDate sections.vorsorgerechner.keyFigures.startdatum}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Zinssatz Sparphase</div><div class="key-figure-value">{{formatPercentage sections.vorsorgerechner.keyFigures.zinsSparen}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Zinssatz Entnahmephase</div><div class="key-figure-value">{{formatPercentage sections.vorsorgerechner.keyFigures.zinsEntnahme}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Anfangskapital</div><div class="key-figure-value">{{formatCurrency sections.vorsorgerechner.keyFigures.anfangskapital}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Benötigte Sparrate (Monatlich)</div><div class="key-figure-value">{{formatCurrency sections.vorsorgerechner.keyFigures.sparrate}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Benötigtes Kapital</div><div class="key-figure-value">{{formatCurrency sections.vorsorgerechner.keyFigures.benoetigtesKapital}}</div></div>
    </div>
    {{#if sections.vorsorgerechner.chartImage}}
      <img src="{{sections.vorsorgerechner.chartImage}}" style="width:100%; height:auto; margin-top:10px;" />
    {{/if}}
    {{#if sections.vorsorgerechner.chartData}}
      <table class="table">
        <thead>
          <tr><th>Jahr</th><th>Sparphase</th><th>Entnahmephase</th></tr>
        </thead>
        <tbody>
          {{#each sections.vorsorgerechner.chartData}}
            <tr>
              <td>{{this.jahr}}</td>
              <td class="currency">{{formatCurrency this.sparen}}</td>
              <td class="currency">{{formatCurrency this.entnehmen}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    {{/if}}
  </div>
  <div class="page-break"></div>
{{/if}}

{{#if sections.ivRechner.present}}
  <div class="section">
    <h2 class="section-title">Invaliditätsrechner</h2>
    <div class="key-figures">
      <div class="key-figure"><div class="key-figure-label">Name</div><div class="key-figure-value">{{sections.ivRechner.keyFigures.vorname}} {{sections.ivRechner.keyFigures.name}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Geburtsdatum</div><div class="key-figure-value">{{formatDate sections.ivRechner.keyFigures.geburtsdatum}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Zivilstand</div><div class="key-figure-value">{{sections.ivRechner.keyFigures.zivilstand}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Kinder</div><div class="key-figure-value">{{sections.ivRechner.keyFigures.kinder}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Bruttolohn</div><div class="key-figure-value">{{formatCurrency sections.ivRechner.keyFigures.bruttoLohn}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Versicherter Lohn</div><div class="key-figure-value">{{formatCurrency sections.ivRechner.keyFigures.versicherterLohn}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Pensionskassenkapital</div><div class="key-figure-value">{{formatCurrency sections.ivRechner.keyFigures.pensionskassenKapital}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Benötigtes Einkommen</div><div class="key-figure-value">{{formatCurrency sections.ivRechner.keyFigures.benoetigtesEinkommen}}</div></div>
      <div class="key-figure"><div class="key-figure-label">BVG-Rente</div><div class="key-figure-value">{{formatCurrency sections.ivRechner.keyFigures.bvgRente}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Lohnzuwachs p.a.</div><div class="key-figure-value">{{formatPercentage sections.ivRechner.keyFigures.lohnzuwachs}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Eintrittsalter</div><div class="key-figure-value">{{sections.ivRechner.keyFigures.eintrittsalter}} Jahre</div></div>
      <div class="key-figure"><div class="key-figure-label">Jahre bis 65</div><div class="key-figure-value">{{sections.ivRechner.keyFigures.jahreBisRente}} Jahre</div></div>
    </div>
    {{#if sections.ivRechner.chartImage}}
      <img src="{{sections.ivRechner.chartImage}}" style="width:100%; height:auto; margin-top:10px;" />
    {{/if}}
  </div>
  <div class="page-break"></div>
{{/if}}

{{#if sections.pension.present}}
{{> pension sections.pension}}
{{/if}}

{{#if sections.health.present}}
{{> health sections.health}}
{{/if}}

{{#if sections.property.present}}
{{> property sections.property}}
{{/if}}

{{#if sections.children.present}}
{{> children sections.children}}
{{/if}}
    
    {{> appendix}}

    <div class="footer">
        Seite <span class="page-number"></span> | JB Finanz AG · Vertraulich
    </div>
</body>
</html>

