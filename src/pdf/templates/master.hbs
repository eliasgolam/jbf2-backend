<!DOCTYPE html>
<html lang="de-CH">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JB Finanz - Beratungsanalyse</title>
    <style>
        @page {
            size: A4;
            margin: 12mm;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 11pt;
            line-height: 1.4;
            color: #333;
            margin: 0;
            padding: 0;
        }
        
        .header {
            border-bottom: 2px solid #2c5aa0;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }
        
        .logo {
            font-size: 18pt;
            font-weight: bold;
            color: #2c5aa0;
        }
        
        .footer {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            text-align: center;
            font-size: 9pt;
            color: #666;
            border-top: 1px solid #ddd;
            padding: 5px 0;
        }
        
        .page-break {
            page-break-before: always;
        }
        
        .section {
            margin-bottom: 20px;
        }
        
        .section-title {
            font-size: 14pt;
            font-weight: bold;
            color: #2c5aa0;
            margin-bottom: 10px;
            border-bottom: 1px solid #ddd;
            padding-bottom: 5px;
        }
        
        .key-figures {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            margin: 10px 0;
        }
        
        .key-figure {
            background: #f8f9fa;
            padding: 10px;
            border-radius: 4px;
            border-left: 4px solid #2c5aa0;
            min-width: 120px;
        }
        
        .key-figure-label {
            font-size: 9pt;
            color: #666;
            margin-bottom: 2px;
        }
        
        .key-figure-value {
            font-size: 12pt;
            font-weight: bold;
            color: #2c5aa0;
        }
        
        .table {
            width: 100%;
            border-collapse: collapse;
            margin: 10px 0;
        }
        
        .table th, .table td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }
        
        .table th {
            background-color: #f8f9fa;
            font-weight: bold;
        }
        
        .currency {
            text-align: right;
        }
        
        .percentage {
            text-align: right;
        }
        
        .date {
            text-align: right;
        }
        
        .confidential {
            font-size: 8pt;
            color: #999;
            text-align: center;
            margin-top: 10px;
        }
        
        .debug {
            background-color: #fff3cd;
            border: 1px solid #ffeaa7;
            color: #856404;
            padding: 8px;
            margin: 10px 0;
            border-radius: 4px;
            font-size: 10pt;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="logo">JB Finanz AG</div>
        <div style="font-size: 10pt; color: #666;">Beratungsanalyse - {{meta.clientName}}</div>
        <div style="font-size: 9pt; color: #666;">Erstellt am: {{formatDate meta.createdAt}}</div>
    </div>

    {{> cover}}
    
    {{#if executiveSummary}}
        {{> executiveSummary}}
    {{/if}}
    
{{#if sections.budget}}
  {{> budget sections.budget}}
{{/if}}

{{#if sections.savingsPlanner}}
  {{> savings sections.savingsPlanner}}
{{/if}}

{{#if sections.interestCompare.present}}
  <div class="section">
    <h2 class="section-title">Zinsvergleich</h2>
    <div class="key-figures">
      <div class="key-figure"><div class="key-figure-label">Anfangskapital</div><div class="key-figure-value">{{formatCurrency sections.interestCompare.keyFigures.initial}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Sparrate</div><div class="key-figure-value">{{formatCurrency sections.interestCompare.keyFigures.monthly}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Laufzeit</div><div class="key-figure-value">{{sections.interestCompare.keyFigures.years}} Jahre</div></div>
      <div class="key-figure"><div class="key-figure-label">Intervall</div><div class="key-figure-value">{{sections.interestCompare.keyFigures.interval}}</div></div>
      <div class="key-figure"><div class="key-figure-label">Einzahlungsart</div><div class="key-figure-value">{{sections.interestCompare.keyFigures.mode}}</div></div>
    </div>
    <table class="table">
      <thead><tr><th>Jahr</th>{{#each sections.interestCompare.rates}}<th>Zins {{this}}%</th>{{/each}}</tr></thead>
      <tbody>
        {{#each sections.interestCompare.chartData}}
          <tr>
            <td>{{this.jahr}}</td>
            {{#each ../sections.interestCompare.rates}}
              <td class="currency">{{formatCurrency (lookup ../this (concat 'zins' this))}}</td>
            {{/each}}
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
{{/if}}

{{#if sections.pension.present}}
{{> pension sections.pension}}
{{/if}}

{{#if sections.health.present}}
{{> health sections.health}}
{{/if}}

{{#if sections.property.present}}
{{> property sections.property}}
{{/if}}

{{#if sections.children.present}}
{{> children sections.children}}
{{/if}}
    
    {{> appendix}}

    <div class="footer">
        Seite <span class="page-number"></span> | JB Finanz AG · Vertraulich
    </div>
</body>
</html>

