        <tbody>
            <tr>
                <td><strong>Kunde</strong></td>
                <td>{{meta.clientName}} ({{meta.clientId}})</td>
            </tr>
            <tr>
                <td><strong>Berater</strong></td>
                <td>{{meta.consultantName}}</td>
            </tr>
            <tr>
                <td><strong>Erstellt am</strong></td>
                <td>{{formatDate meta.createdAt}}</td>
            </tr>
            <tr>
                <td><strong>Version</strong></td>
