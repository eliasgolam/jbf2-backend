{{#if keyFigures.premiumRegion}}
  <div class="kf">
    <div class="key-figure-label">Prämienregion</div>
    <div class="key-figure-value">{{keyFigures.premiumRegion}}</div>
  </div>
{{/if}}

{{#if keyFigures.franchise}}
  <div class="kf">
    <div class="key-figure-label">Franchise</div>
    <div class="key-figure-value">{{formatCurrency keyFigures.franchise}}</div>
  </div>
{{/if}}

{{#if keyFigures.premiumAdult}}
  <div class="kf">
    <div class="key-figure-label">Monatliche Prämie</div>
    <div class="key-figure-value">{{formatCurrency keyFigures.premiumAdult}}</div>
  </div>
{{/if}}

{{#if keyFigures.deductible}}
  <div class="kf">
    <div class="key-figure-label">Selbstbehalt</div>
    <div class="key-figure-value">{{formatCurrency keyFigures.deductible}}</div>
  </div>
{{/if}}

{{#if keyFigures.yearlyCost}}
  <div class="kf">
    <div class="key-figure-label">Jährliche Prämie</div>
    <div class="key-figure-value">{{formatCurrency keyFigures.yearlyCost}}</div>
  </div>
{{/if}}

{{#if keyFigures.maxDeductible}}
  <div class="kf">
    <div class="key-figure-label">Max. Selbstbehalt</div>
    <div class="key-figure-value">{{formatCurrency keyFigures.maxDeductible}}</div>
  </div>
{{/if}}

{{#if notes}}
{{notes}}
{{/if}}

