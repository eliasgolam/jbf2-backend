<div class="section">
    <h2 class="section-title">{{title}}</h2>
    
    <p class="debug">DBG Property Value: {{formatCurrency keyFigures.propertyValue}}</p>
    
    {{#if keyFigures}}
    <div class="key-figures">
        {{#if keyFigures.propertyValue}}
        <div class="key-figure">
            <div class="key-figure-label">Immobilienwert</div>
            <div class="key-figure-value">{{formatCurrency keyFigures.propertyValue}}</div>
        </div>
        {{/if}}
        {{#if keyFigures.equity}}
        <div class="key-figure">
            <div class="key-figure-label">Eigenkapital</div>
            <div class="key-figure-value">{{formatCurrency keyFigures.equity}}</div>
        </div>
        {{/if}}
        {{#if keyFigures.mortgage}}
        <div class="key-figure">
            <div class="key-figure-label">Hypothek</div>
            <div class="key-figure-value">{{formatCurrency keyFigures.mortgage}}</div>
        </div>
        {{/if}}
        {{#if keyFigures.monthlyPayment}}
        <div class="key-figure">
            <div class="key-figure-label">Monatliche Rate</div>
            <div class="key-figure-value">{{formatCurrency keyFigures.monthlyPayment}}</div>
        </div>
        {{/if}}
    </div>
    {{/if}}
    
    <table class="table">
        <thead>
            <tr>
                <th>Kategorie</th>
                <th class="currency">Betrag (CHF)</th>
                <th class="percentage">Anteil (%)</th>
            </tr>
        </thead>
        <tbody>
            {{#if keyFigures.propertyValue}}
            <tr>
                <td>Immobilienwert</td>
                <td class="currency">{{formatCurrency keyFigures.propertyValue}}</td>
                <td class="percentage">100%</td>
            </tr>
            {{/if}}
            {{#if keyFigures.equity}}
            <tr>
                <td>Eigenkapital</td>
                <td class="currency">{{formatCurrency keyFigures.equity}}</td>
                <td class="percentage">{{formatPercentage keyFigures.equityRatio}}</td>
            </tr>
            {{/if}}
            {{#if keyFigures.mortgage}}
            <tr>
                <td>Hypothek</td>
                <td class="currency">{{formatCurrency keyFigures.mortgage}}</td>
                <td class="percentage">{{formatPercentage keyFigures.mortgageRatio}}</td>
            </tr>
            {{/if}}
        </tbody>
    </table>
    
    <div style="margin-top: 15px; padding: 15px; background: {{#if keyFigures.affordable}}#d4edda{{else}}#f8d7da{{/if}}; border: 1px solid {{#if keyFigures.affordable}}#c3e6cb{{else}}#f5c6cb{{/if}}; border-radius: 4px;">
        <h4 style="margin: 0 0 10px 0; color: {{#if keyFigures.affordable}}#155724{{else}}#721c24{{/if}};">
            {{#if keyFigures.affordable}}✅ Tragbar{{else}}❌ Nicht tragbar{{/if}}
        </h4>
        <p style="margin: 0; color: {{#if keyFigures.affordable}}#155724{{else}}#721c24{{/if}};">
            {{#if keyFigures.affordable}}
            Die Immobilie ist mit dem aktuellen Einkommen tragbar.
            {{else}}
            Die Immobilie ist mit dem aktuellen Einkommen nicht tragbar. 
            Erforderliches Einkommen: {{formatCurrency keyFigures.requiredIncome}}
            {{/if}}
        </p>
    </div>
    {{/if}}
    
    {{#if notes}}
    <div style="margin-top: 15px; padding: 10px; background: #e8f4fd; border-left: 4px solid #2c5aa0;">
        <strong>Hinweise:</strong> {{notes}}
    </div>
    {{/if}}
</div>

<div class="page-break"></div>

