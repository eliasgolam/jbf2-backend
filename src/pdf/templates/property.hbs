{{#if keyFigures.equity}}
  <div class="kf">
    <div class="key-figure-label">Eigenmittel</div>
    <div class="key-figure-value">{{formatCurrency keyFigures.equity}}</div>
  </div>
{{/if}}

{{#if keyFigures.mortgage}}
  <div class="kf">
    <div class="key-figure-label">Hypothek</div>
    <div class="key-figure-value">{{formatCurrency keyFigures.mortgage}}</div>
  </div>
{{/if}}

{{#if keyFigures.monthlyPayment}}
  <div class="kf">
    <div class="key-figure-label">Monatliche Belastung</div>
    <div class="key-figure-value">{{formatCurrency keyFigures.monthlyPayment}}</div>
  </div>
{{/if}}

{{#if keyFigures.affordabilityRatio}}
  <div class="kf">
    <div class="key-figure-label">Tragbarkeit</div>
    <div class="key-figure-value">{{formatPercentage keyFigures.affordabilityRatio}}</div>
  </div>
{{/if}}

{{#if keyFigures.interestRate}}
  <div class="kf">
    <div class="key-figure-label">Zinssatz</div>
    <div class="key-figure-value">{{formatPercentage keyFigures.interestRate}}</div>
  </div>
{{/if}}

{{#if keyFigures.amortization}}
  <div class="kf">
    <div class="key-figure-label">Amortisation</div>
    <div class="key-figure-value">{{formatCurrency keyFigures.amortization}}</div>
  </div>
{{/if}}

{{#if notes}}
{{notes}}
{{/if}}

